    "format:check": "prettier --check src tests scripts *.json *.ts index.html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.0"
  }
}
